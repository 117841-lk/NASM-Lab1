{
  "name": "asm-labs",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Wymagane m.in. przez GDB / ptrace podczas debugowania programów asm/C/C++
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "ms-vscode.makefile-tools",
        "ms-vscode.cpptools"
      ]
    }
  },

  "remoteUser": "vscode"
}
